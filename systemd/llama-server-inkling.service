[Unit]
Description=llama.cpp server (Inkling 2 Mini, Vulkan)
After=network.target

[Service]
Type=simple
# Installs strip RUNPATH; the libraries need this path.
Environment=LD_LIBRARY_PATH=%h/.local/share/llama.cpp/lib
# The multimodal build: model + vision projector.
ExecStart=%h/.local/bin/llama-server \
    -m %h/models/inkling2/Inkling-2-Mini-UD-Q3_K_XL.gguf \
    --mmproj %h/models/inkling2/mmproj-Inkling-2-Mini-Q8_0.gguf \
    -ngl 99 \
    -c 131072 \
    --cache-type-k q8_0 \
    --cache-type-v q8_0 \
    --jinja \
    --parallel 1 \
    --host 127.0.0.1 \
    --port 8882 \
    --timeout 300
Restart=on-failure
RestartSec=10

[Install]
WantedBy=default.target
